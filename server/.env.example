# InternHub Server Environment Configuration Example
# Copy this file to .env and adjust values for local development.
# Never commit the actual .env file to source control.

# Server
PORT=5000
NODE_ENV=development

# SQLite database file path (relative to server directory)
DATABASE_PATH=./data/internships.db

# CORS — comma-separated list of allowed frontend origins
# In production set this to your actual deployed frontend URL(s)
FRONTEND_ORIGIN=http://localhost:5173

# General API rate limit (all /api/* routes)
# Window in milliseconds and max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Strict rate limit for POST /api/applications (submission spam prevention)
APPLY_RATE_LIMIT_WINDOW_MS=900000
APPLY_RATE_LIMIT_MAX=10

# Administrative API authorization key
# When set, mutations (POST/PUT/DELETE /api/internships) require header x-api-key or Authorization: Bearer <key>.
# If unset in production (NODE_ENV=production), administrative mutations are disabled (403 Forbidden).
ADMIN_API_KEY=your-secure-admin-api-key-here

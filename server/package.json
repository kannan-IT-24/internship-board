{
  "name": "internhub-server",
  "version": "1.0.0",
  "description": "Express.js and SQLite REST API for InternHub",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
